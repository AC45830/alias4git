[alias]
	st = status -s -b
	cm = commit -m
	co = checkout
	br = branch --sort=-committerdate
	ac = commit -am
	sync = !git co develop && git pull && git co -
	nbr = git co -b
	
	cln = clean -fd
	dcln = clean -dfx
	
	dv = difftool -t vimdiff -y
	map = log --pretty --oneline --graph
	se = !git rev-list --all | xargs git grep -F
	
	gl = cfg -l
	
	npp = "!start notepad++ "
	
	ff = flow feature
	ffl = flow feature list
	ffco = flow feature checkout
	
	catmerge = merge --strategy-option theirs
	

	compare = rev-list --count --left-right
	cmdlist = !git cfg -l | grep 'alias'
	list = !git cfg -l | grep 'alias'
	cfglist = !git cfg -l | grep 'alias'
	
	
	ts = !ls -ll .git/FETCH_HEAD
        lastpull = !ls -ll .git/FETCH_HEAD
	hi = "!f() { echo 'Hello, ' $1; }; f"
	share = "!commitAndPushAlias() { cd c:\\\\gtl\\\\alias4git; git add alias.gitconfig; git commit; }; commitAndPushAlias"

	# from https://github.com/Lior-Katz
	nccommit = commit --allow-empty-message -m \"\"
	gcl = config --global -l
	last = log -1 HEAD --stat
	vimdiff = difftool -t vimdiff -y
	diff-words = diff --color-words='[^[:space:]]|([[:alnum:]]|UTF_8_GUARD)+'
	unstage = restore --staged
	alias = ! git config --get-regexp ^alias\\. | sed -e s/^alias\\.// -e s/\\ /\\ =\\ /
	
[gitflow "branch"]
	master = main
	develop = develop

[gitflow "prefix"]
	feature = feature/
	bugfix = bugfix/
	release = release/
	hotfix = hotfix/
	support = support/
	versiontag = 

[gitflow "path"]
	hooks = .git/hooks

[help]
	autocorrect = 20
[rerere]
	enabled = true
[push]
	autoSetupRemote = true
